# Токен бота от @BotFather (пример! подставьте свой)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# ID админов через запятую (числа). Пример:
ADMIN_IDS=123456789

# ==== Веб-сервер / админ-панель ====
# Порт веб-сайта и Socket.io
PORT=3000
# Публичный адрес сайта (кнопка «Открыть сайт» в боте и ссылки).
# Для локального запуска оставьте http://localhost:3000.
# Для доступа с телефона укажите https://ваш-домен или http://IP:3000.
WEB_URL=http://localhost:3000
# @username бота без собаки — ускоряет показ ссылки на входе.
# Если не задан, сервер сам спросит у Telegram (getMe).
# BOT_USERNAME=my_casino_bot
# Пароль админ-панели http://localhost:3000/admin (обязательно смените!)
ADMIN_PASSWORD=change_me
# Единый запуск: python bot/main.py поднимает и бота, и сайт.
# 0 — запускать только бота (если сайт уже запущен отдельно).
WEB_AUTOSTART=1
# CORS (для одного домена можно оставить *)
CORS_ORIGIN=*
# Путь к SQLite. В Docker уже задан в Dockerfile (/app/data/casino.db),
# локально по умолчанию используется ./data/casino.db — можно не задавать.
# DB_PATH=/app/data/casino.db
NODE_ENV=production

# Стартовый баланс новичка
START_BALANCE=1000

# Лимиты ставок
MIN_BET=1
MAX_BET=1000000

# Комиссия казино в % (0 = без комиссии)
COMMISSION_PERCENT=0

# ==== Очки бота (⭐) — бесплатная валюта для игры с ботом ====
# Стартовые очки новичка
START_POINTS=2000
# Лимиты ставок в очках
POINTS_MIN_BET=10
POINTS_MAX_BET=100000
# Курс обмена: 100 💰 -> 150 ⭐ (1 💰 = 1.5 ⭐)
POINTS_BUY_RATE=150
# Курс обмена: 100 ⭐ -> 60 💰 (1 ⭐ = 0.6 💰)
POINTS_SELL_RATE=60

# Минимальная сумма вывода
WITHDRAW_MIN=1000

# Текст о способе выплаты (показывается при выводе)
WITHDRAW_NOTE=Выплаты производятся в виде Telegram Premium

# ==== Донат по реквизитам карты (можно менять и в /admin → Настройки) ====
# Тип карты / банк
DONATE_CARD_TYPE=Сбербанк
# Номер карты
DONATE_CARD_NUMBER=2202202045612345
# ФИО получателя
DONATE_CARD_NAME=Иванов Иван Иванович

# Сколько секунд комната ждёт соперника
JOIN_TIMEOUT=15

# Сколько секунд бот ждёт ход игрока, потом ходит сам
MOVE_TIMEOUT=30

# Имитация «вращения кубика»: пауза между броском и раскрытием результата (сек)
DICE_ROLL_DELAY=3

# Через сколько секунд удалять сообщение с результатом игры
RESULT_MSG_TTL=15

# Как часто проверять авто-рассылки баннеров (в секундах)
BANNER_CHECK_INTERVAL=30
